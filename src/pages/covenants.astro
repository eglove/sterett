---
import { getEmDashCollection, getSiteSettings } from "emdash";
import Base from "../layouts/Base.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";

const { entries: documents, cacheHint } = await getEmDashCollection("covenants", {
	orderBy: { created_at: "asc" },
});
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const { siteTitle } = resolveStarterSiteIdentity(await getSiteSettings());

/** Resolve a Media Library file to a public URL. */
function fileUrl(file: any): string | null {
	if (!file) return null;
	const storageKey =
		typeof file?.meta?.storageKey === "string" ? file.meta.storageKey : null;
	if (storageKey) return Astro.locals.emdash?.getPublicMediaUrl?.(storageKey) ?? null;
	if (file?.provider === "external") return file?.src ?? null;
	return file?.url ?? null;
}

const docs = (documents ?? [])
	.map((doc) => ({
		label: doc.data.file?.filename ?? "Village document",
		url: fileUrl(doc.data.file),
		type: doc.data.file?.mimeType ?? null,
	}))
	.filter((doc) => doc.url);
---

<Base
	title="Covenants & Documents"
	description={`Governing documents and covenants for ${siteTitle}.`}
>
	<section class="page-head">
		<div class="shell">
			<p class="eyebrow">Reference</p>
			<h1>Covenants &amp; documents</h1>
			<p class="lede">
				The rules that govern the village, kept in one place so residents can
				read them before building, buying, or renovating.
			</p>
		</div>
	</section>

	<section class="section">
		<div class="shell">
			{
				docs.length === 0 ? (
					<p class="empty-note">
						No documents have been published yet. Please check back soon.
					</p>
				) : (
					<ul class="docs">
						{docs.map((doc) => (
							<li>
								<a
									class="docs__row"
									href={doc.url}
									target="_blank"
									rel="noopener noreferrer"
								>
									<span class="docs__icon" aria-hidden="true">
										<svg
											width="22"
											height="22"
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="1.5"
											stroke-linecap="round"
											stroke-linejoin="round"
										>
											<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
											<path d="M14 2v6h6" />
										</svg>
									</span>
									<span class="docs__label">{doc.label}</span>
									<span class="docs__action">Download</span>
								</a>
							</li>
						))}
					</ul>
				)
			}
		</div>
	</section>
</Base>

<style>
	.page-head {
		padding-block: clamp(3rem, 7vw, 5rem) clamp(1.5rem, 3vw, 2.5rem);
		border-bottom: 1px solid var(--line);
	}

	.page-head h1 {
		font-size: clamp(2.25rem, 4.5vw, 3.5rem);
		margin-block: 0.75rem 1.25rem;
	}

	.docs {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--line);
		max-width: 52rem;
	}

	.docs li {
		border-bottom: 1px solid var(--line);
	}

	.docs__row {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 1.25rem 0.5rem;
		text-decoration: none;
		color: var(--ink);
		transition: background 0.15s ease, padding-left 0.15s ease;
	}

	.docs__row:hover {
		background: var(--paper-raised);
		padding-left: 1rem;
	}

	.docs__icon {
		display: grid;
		place-items: center;
		color: var(--clay);
		flex: none;
	}

	.docs__label {
		flex: 1;
		font-size: 1.05rem;
	}

	.docs__action {
		font-size: 0.72rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--ink-faint);
		flex: none;
	}

	.empty-note {
		color: var(--ink-soft);
	}
</style>

---
import {
	getEmDashCollection,
	getEmDashEntry,
	getSeoMeta,
	getSiteSettings,
} from "emdash";
import { Image, PortableText } from "emdash/ui";
import Base from "../layouts/Base.astro";
import { resolveStarterSiteIdentity } from "../utils/site-identity";

const { entries: trustees, cacheHint } = await getEmDashCollection("trustees", {
	orderBy: { created_at: "asc" },
});
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

/* The words above the roster are ordinary CMS content — the "trustees" page in
   the Pages collection, written in the same rich text editor as the home page.
   The roster below still comes from the Trustees collection, so the prose and
   the cards are edited independently. */
const { entry: page, cacheHint: pageCacheHint } = await getEmDashEntry(
	"pages",
	"trustees",
);
if (Astro.cache?.enabled) Astro.cache.set(pageCacheHint);

const { siteTitle } = resolveStarterSiteIdentity(await getSiteSettings());

const content = page?.data.content ?? [];
const hasContent = Array.isArray(content) && content.length > 0;

const seo = page
	? getSeoMeta(page, {
		siteTitle,
		siteUrl: Astro.url.origin,
		path: Astro.url.pathname.replace(/\/$/, ""),
		titleSeparator: " — ",
		defaultDescription: `The trustees of ${siteTitle}.`,
	})
	: {
		title: `Board of Trustees — ${siteTitle}`,
		ogTitle: null,
		description: `The trustees of ${siteTitle}.`,
		canonical: null,
	};

/** Phone numbers are stored as numbers; render them as a readable string. */
function formatPhone(value: number | null | undefined) {
	if (value === null || value === undefined) return null;
	const digits = String(Math.trunc(value)).replace(/\D/g, "");
	if (digits.length === 10) {
		return `(${digits.slice(0, 3)}) ${digits.slice(3, 6)}-${digits.slice(6)}`;
	}
	return String(Math.trunc(value));
}

function initials(name: string | null | undefined) {
	if (!name) return "";
	return name
		.split(/\s+/)
		.filter(Boolean)
		.slice(0, 2)
		.map((part) => part[0]?.toUpperCase() ?? "")
		.join("");
}

const board = (trustees ?? []).map((trustee) => ({
	name: trustee.data.name,
	role: trustee.data.title ?? null,
	phone: formatPhone(trustee.data.phonenumber),
	image: trustee.data.image ?? null,
	monogram: initials(trustee.data.name),
	edit: trustee.edit,
}));
---

<Base
	title={seo.title}
	pageTitle={seo.ogTitle}
	description={seo.description}
	canonical={seo.canonical}
	content={page ? { collection: "pages", id: page.data.id, slug: "trustees" } : undefined}
>
	<section class="page-head">
		<div class="shell">
			{
				hasContent ? (
					<article class="prose page-head__prose">
						<PortableText value={content} />
					</article>
				) : (
					<h1 class="page-head__title" {...(page?.edit.title ?? {})}>
						{page?.data.title ?? "Board of Trustees"}
					</h1>
				)
			}
		</div>
	</section>

	<section class="section">
		<div class="shell">
			{
				board.length === 0 ? (
					<p class="empty-note">
						The current roster is being updated. Please check back soon.
					</p>
				) : (
					<ul class="board">
						{board.map((member) => (
							<li class="board__card">
								<div class="board__portrait">
									{member.image ? (
										<Image image={member.image} alt={member.name} />
									) : (
										<span aria-hidden="true">{member.monogram}</span>
									)}
								</div>
								<div class="board__body">
									<h2 class="board__name" {...member.edit.name}>
										{member.name}
									</h2>
									{member.role && (
										<p class="board__role" {...member.edit.title}>
											{member.role}
										</p>
									)}
									{member.phone && (
										<p class="board__phone">
											<a href={`tel:${member.phone.replace(/[^0-9]/g, "")}`}>
												{member.phone}
											</a>
										</p>
									)}
								</div>
							</li>
						))}
					</ul>
				)
			}
		</div>
	</section>
</Base>

<style>
	.page-head {
		padding-block: clamp(3rem, 7vw, 5rem) clamp(1.5rem, 3vw, 2.5rem);
		border-bottom: 1px solid var(--line);
	}

	.page-head__prose > :global(:first-child) {
		margin-top: 0;
	}

	/* The editor's own headings carry the page structure; this only sets the
	   rhythm and the size of the opening title. */
	.page-head__prose :global(h1) {
		font-family: var(--type-display);
		font-size: clamp(2.25rem, 4.5vw, 3.5rem);
		line-height: 1.05;
		letter-spacing: -0.02em;
		color: var(--ink);
		margin-bottom: 0;
	}

	.page-head__prose :global(h2) {
		margin-top: 2em;
	}

	/* The paragraph under the title reads as the page's lede. */
	.page-head__prose :global(h1 + p) {
		font-size: var(--step-1);
		line-height: 1.6;
		max-width: 54ch;
	}

	.page-head__title {
		font-size: clamp(2.25rem, 4.5vw, 3.5rem);
		margin-block: 0.75rem 1.25rem;
	}

	.board {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr));
		gap: 1.5rem;
	}

	.board__card {
		display: flex;
		gap: 1.25rem;
		padding: 1.75rem;
		background: var(--paper-raised);
		border: 1px solid var(--line);
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-soft);
	}

	.board__portrait {
		display: grid;
		place-items: center;
		width: 4.5rem;
		height: 4.5rem;
		flex: none;
		border-radius: 50%;
		overflow: hidden;
		background: var(--water-tint);
		color: var(--water);
		font-family: var(--font-display);
		font-size: 1.35rem;
		letter-spacing: 0.02em;
	}

	.board__portrait :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.board__name {
		font-size: 1.25rem;
		font-weight: 500;
	}

	.board__role {
		margin-top: 0.35rem;
		font-size: 0.72rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--clay);
	}

	.board__phone {
		margin-top: 0.6rem;
		font-size: 0.95rem;
	}

	.board__phone a {
		text-decoration: none;
		border-bottom: 1px solid var(--line-strong);
	}

	.board__phone a:hover {
		border-bottom-color: var(--clay);
	}

	.empty-note {
		color: var(--ink-soft);
	}
</style>

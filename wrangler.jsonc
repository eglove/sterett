{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "sterett-site",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": [
		"nodejs_compat"
	],
	// sterettcreekvillagetrustee.com serves the site. www is routed to the same
	// Worker only so src/worker.ts can redirect it to the apex.
	"routes": [
		{
			"pattern": "sterettcreekvillagetrustee.com",
			"custom_domain": true
		},
		{
			"pattern": "www.sterettcreekvillagetrustee.com",
			"custom_domain": true
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "sterett-site",
			"database_id": "9e3eefe4-14cc-4796-b9d4-7a57be5acaaf",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "sterett-media",
		},
	],
	// Co-editing rooms, one Durable Object per entry being edited
	"durable_objects": {
		"bindings": [
			{
				"name": "EMDASH_ROOMS",
				"class_name": "EmDashRoom"
			}
		],
	},
	"exports": {
		"EmDashRoom": {
			"type": "durable-object",
			"storage": "sqlite"
		},
	},
	// Sandboxed plugins require Worker Loader, available on Workers paid plans.
	"worker_loaders": [
		{
			"binding": "LOADER"
		}
	],
	// General maintenance cron trigger
	"triggers": {
		"crons": [
			"* * * * *"
		],
	},
}